# Database Connection URL (Neon / PostgreSQL serverless connection string)
# Neon example:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-your-project-id.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Or pooled connection:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-your-project-id-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Environment
NODE_ENV="production"

# Administrator Email (Superadmin & PRO)
SUPERADMIN_EMAIL="[EMAIL_ADDRESS]"
PRO_ADMIN_EMAIL="[EMAIL_ADDRESS]"
SUPERADMIN_PIN="1945"
PRO_ADMIN_PIN="1945"

# Security & Secrets
JWT_SECRET="your-secure-jwt-secret-at-least-32-chars-long"

# YouTube Channel Handle
YOUTUBE_CHANNEL="@jccf_futa"
