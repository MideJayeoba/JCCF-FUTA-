# DATABASE CONFIGURATION:
# For Render, Supabase, Neon, or cloud Postgres instances, provide the connection URI:
DATABASE_URL="postgres://username:password@hostname:5432/database_name?sslmode=require"

# Alternatively, discrete SQL variables can be used:
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for enriched video metadata.
# If omitted, the application uses zero-configuration YouTube oEmbed metadata extraction automatically.
YOUTUBE_API_KEY=

# YOUTUBE_CHANNEL: Fixed YouTube channel handle for JCCF FUTA broadcasts
YOUTUBE_CHANNEL="@jccf_futa"

# SECURITY & AUTHENTICATION (Restricted strictly to Superadmin & JCCF PRO)
# All sensitive credentials are read from environment secrets - no hardcoded passwords in client code.
SUPERADMIN_EMAIL="jayeobapeace19459@gmail.com"
SUPERADMIN_PASSWORD=
SUPERADMIN_PIN=
PRO_ADMIN_EMAIL="pro@jccf-futa.org"
PRO_ADMIN_PASSWORD=
PRO_ADMIN_PIN=
JWT_SECRET=
